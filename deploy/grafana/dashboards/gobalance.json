{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Request Rate by Backend",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(gobalance_requests_total[30s])",
          "legendFormat": "{{backend}} ({{code}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 10, "stacking": { "mode": "none" } }
        }
      }
    },
    {
      "title": "Request Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(gobalance_request_duration_seconds_bucket[30s])) by (le, backend))",
          "legendFormat": "{{backend}} p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(gobalance_request_duration_seconds_bucket[30s])) by (le, backend))",
          "legendFormat": "{{backend}} p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(gobalance_request_duration_seconds_bucket[30s])) by (le, backend))",
          "legendFormat": "{{backend}} p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 0 }
        }
      }
    },
    {
      "title": "Backend Health",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "gobalance_backend_healthy",
          "legendFormat": "{{backend}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1,
          "custom": { "fillOpacity": 30, "stacking": { "mode": "none" } }
        }
      }
    },
    {
      "title": "Circuit Breaker State",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "gobalance_breaker_state",
          "legendFormat": "{{backend}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1,
          "custom": { "fillOpacity": 30 },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "closed" }, "0.5": { "text": "half_open" }, "1": { "text": "open" } } }
          ]
        }
      }
    },
    {
      "title": "In-Flight Requests",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "gobalance_backend_inflight",
          "legendFormat": "{{backend}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 20 } } }
    },
    {
      "title": "Retry Budget Tokens",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "gobalance_retry_budget_tokens",
          "legendFormat": "tokens",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "min": 0, "custom": { "fillOpacity": 20 } }
      }
    },
    {
      "title": "Failures by Type",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 14 },
      "targets": [
        {
          "expr": "rate(gobalance_failures_total[30s])",
          "legendFormat": "{{backend}} ({{type}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "Retries",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 14 },
      "targets": [
        {
          "expr": "rate(gobalance_retries_total[30s])",
          "legendFormat": "{{backend}} ({{outcome}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "Traffic Share by Backend (%)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "sum(increase(gobalance_requests_total[1m])) by (backend)",
          "legendFormat": "{{backend}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Throughput (total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 20 },
      "targets": [
        {
          "expr": "sum(rate(gobalance_requests_total[30s]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "title": "Error Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 20 },
      "targets": [
        {
          "expr": "sum(rate(gobalance_failures_total[30s])) / sum(rate(gobalance_requests_total[30s])) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["gobalance"],
  "templating": { "list": [] },
  "time": { "from": "now-5m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "GoBalance",
  "uid": "gobalance-main"
}
